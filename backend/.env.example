APP_NAME=Klearcom
APP_ENV=local
APP_KEY=
# Set to false in production — never expose stack traces publicly.
APP_DEBUG=false
APP_URL=http://localhost:8080

# Comma-separated list of allowed CORS origins (no wildcards in production).
# Example: https://app.klearcom.com,https://admin.klearcom.com
APP_ALLOWED_ORIGINS=http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=klearcom
DB_USERNAME=klearcom
DB_PASSWORD=secret

MONGODB_URI=mongodb://mongodb:27017/klearcom
